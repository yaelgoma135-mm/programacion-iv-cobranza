# Copia este archivo como .env y pon tus propios valores.
# El .env NO se sube al repositorio: contiene credenciales.

# Cadena de conexión de MongoDB Atlas.
# Se obtiene en Atlas → Database → Connect → Drivers → Python.
# Recuerda reemplazar <password> por la contraseña real del usuario.
MONGODB_URI=mongodb+srv://usuario:contrasena@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Base de datos dentro del cluster. Si no existe, Mongo la crea al primer insert.
MONGODB_BASE=cobranza_escuela

# Tope de escenarios por petición, para que nadie acapare un hilo por minutos.
MAX_ESCENARIOS=200000
